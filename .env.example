# PSA INVESTMENT - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' or set these variables in your hosting dashboard (Vercel / QServer / Netlify).
# 2. DO NOT commit '.env.local' or any file containing real API keys to GitHub.
# 3. All VITE_* variables are exposed to the browser client; never place service_role or master database passwords here.

# --- ZERO-COST CLOUD DATABASE (Supabase PostgreSQL / Edge REST) ---
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# --- PRODUCTION DOMAIN & CANONICAL URL ---
VITE_CANONICAL_DOMAIN=https://psainvestment.com.ng
VITE_SITE_ENVIRONMENT=production

# --- GOOGLE ADSENSE INTEGRATION ---
VITE_GOOGLE_ADS_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
